{
  "name": "daeri-gisa-static",
  "private": true,
  "scripts": {
    "dev": "node -e \"const http=require('http'),fs=require('fs'),path=require('path'),p=Number(process.env.PORT)||3000,root=process.cwd();http.createServer((req,res)=>{const parts=(req.url||'/').split('?'),u=parts[0],qs=parts[1]||'';if(u==='/favicon.ico'){const fav=fs.existsSync(path.join(root,'favicon.ico'))?path.join(root,'favicon.ico'):path.join(root,'public','favicon.ico');if(fs.existsSync(fav)){res.writeHead(200,{'Content-Type':'image/x-icon'});if(req.method!=='HEAD')fs.createReadStream(fav).pipe(res);else res.end();return;}}const idx=fs.existsSync(path.join(root,'index.html'))?path.join(root,'index.html'):path.join(root,'dist','index.html');const headers={'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-cache'};if(qs.includes('download=1'))headers['Content-Disposition']='attachment; filename=\\\"index.html\\\"';res.writeHead(200,headers);if(req.method!=='HEAD')fs.createReadStream(idx).pipe(res);else res.end();}).listen(p,'0.0.0.0',()=>console.log('Listening on http://0.0.0.0:'+p))\"",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path'),p=Number(process.env.PORT)||3000,root=process.cwd();http.createServer((req,res)=>{const parts=(req.url||'/').split('?'),u=parts[0],qs=parts[1]||'';if(u==='/favicon.ico'){const fav=fs.existsSync(path.join(root,'favicon.ico'))?path.join(root,'favicon.ico'):path.join(root,'public','favicon.ico');if(fs.existsSync(fav)){res.writeHead(200,{'Content-Type':'image/x-icon'});if(req.method!=='HEAD')fs.createReadStream(fav).pipe(res);else res.end();return;}}const idx=fs.existsSync(path.join(root,'index.html'))?path.join(root,'index.html'):path.join(root,'dist','index.html');const headers={'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-cache'};if(qs.includes('download=1'))headers['Content-Disposition']='attachment; filename=\\\"index.html\\\"';res.writeHead(200,headers);if(req.method!=='HEAD')fs.createReadStream(idx).pipe(res);else res.end();}).listen(p,'0.0.0.0',()=>console.log('Listening on http://0.0.0.0:'+p))\"",
    "build": "node -e \"const fs=require('fs'),path=require('path'),vm=require('vm');const html=fs.readFileSync('index.html','utf8');const m=html.match(/<script>([\\s\\S]*?)<\\/script>/);if(!m)process.exit(1);new vm.Script(m[1]);fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('index.html',path.join('dist','index.html'));if(fs.existsSync('favicon.ico'))fs.copyFileSync('favicon.ico',path.join('dist','favicon.ico'));console.log('Built dist/index.html');\"",
    "lint": "node -e \"const fs=require('fs'),vm=require('vm');const html=fs.readFileSync('index.html','utf8');const m=html.match(/<script>([\\s\\S]*?)<\\/script>/);if(!m)process.exit(1);new vm.Script(m[1]);\""
  }
}
